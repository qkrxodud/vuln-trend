# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# NVD API 키: https://nvd.nist.gov/developers/request-an-api-key (키 없으면 30초 5회, 있으면 50회)
NVD_API_KEY=

# 로컬 Postgres 호스트 포트(기본 5432). 다른 프로젝트가 5432 를 쓰면 바꾼다. docker compose 와 배치가 함께 읽는다
DB_PORT=5432

# 한국어 요약(선택). Anthropic API 키: https://console.anthropic.com/ — 비워 두면 요약 단계만 건너뛰고 배치는 그대로 돈다
SUMMARY_API_KEY=
# 비워 두면 claude-opus-5-5
SUMMARY_MODEL=

# 사이트 데이터를 push 할 git 원격 이름(기본 origin). 원격은 사용자가 만든다
PUBLISH_REMOTE=
